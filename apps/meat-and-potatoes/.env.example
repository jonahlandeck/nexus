# ---- Meat And Potatoes configuration -------------------------------------------
# Copy this file to ".env" and fill in the blanks. ".env" is gitignored.

# Local Ollama (https://ollama.com). Pull the model first:  ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Seconds to wait on the model. Raise it if you run a big model on modest hardware.
OLLAMA_TIMEOUT=180

# Walmart grocery provider: "scraperapi" | "mock" | "links"
#   scraperapi - live Walmart data via https://www.scraperapi.com (needs SCRAPERAPI_KEY)
#   mock       - canned data, no network, good for trying the app out
#   links      - no search calls at all, just Walmart search + add-to-cart links (0 credits)
MAP_PROVIDER=mock

# ScraperAPI key - only needed when MAP_PROVIDER=scraperapi
SCRAPERAPI_KEY=
SCRAPERAPI_TLD=com

# How long a cached Walmart search stays fresh before we spend another credit
SEARCH_CACHE_TTL_DAYS=7

# SQLite database file (relative to apps/meat-and-potatoes/)
DB_PATH=backend/data/map.db

# Frontend origin allowed through CORS
CORS_ORIGIN=http://localhost:5173
