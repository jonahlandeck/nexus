{
  // Root site for landeck.pro - "the motherboard's" front door.
  // Assets-only Worker (no script): serves ./site as static files.
  // Individual apps deploy as their own Workers from apps/<slug>/ and claim
  // more-specific routes (e.g. landeck.pro/apps/meat-and-potatoes*), so they
  // take precedence over this Worker's "landeck.pro/*" for their own paths.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "compatibility_date": "2026-09-06",
  "assets": { "directory": "./site" },
  "routes": [
    { "pattern": "landeck.pro/*", "zone_name": "landeck.pro" }
  ],
  "observability": { "enabled": true }
}
