# Authentik configuration. Copy to ".env" (gitignored) and fill in.
# ".env" lives on the VPS only — none of these belong in Cloudflare Secrets
# Store (Authentik isn't on Cloudflare).

# ---- Postgres --------------------------------------------------------------
# openssl rand -base64 36
PG_PASS=

# ---- Authentik core ------------------------------------------------------------
# openssl rand -base64 60
AUTHENTIK_SECRET_KEY=

# Pin the image tag (default in compose is a fallback, not a pin).
AUTHENTIK_TAG=2026.8.1

# Publish the HTTP port on this loopback port (the tunnel reaches the container
# in-network; this is just for local debugging on the box).
COMPOSE_PORT_HTTP=9000

AUTHENTIK_ERROR_REPORTING__ENABLED=false

# ---- First-boot bootstrap ----------------------------------------------------
# Initial password for the built-in `akadmin` superuser.
AUTHENTIK_BOOTSTRAP_PASSWORD=

# `akadmin` API token — BREAK-GLASS ONLY. Stays on this box. Never goes to
# nexus or Cloudflare Secrets Store; nexus uses the scoped svc-nexus token that
# blueprints/nexus.yaml mints. openssl rand -hex 32
AUTHENTIK_BOOTSTRAP_TOKEN=

AUTHENTIK_BOOTSTRAP_EMAIL=jlandeck927@gmail.com

# ---- Email ---------------------------------------------------------------------
# Email config is NOT here — it lives in a swappable preset file `mail.env`
# (gitignored), loaded as an optional second env_file by docker-compose.yml.
# Pick a provider:
#     cp mail/gmail.env.example   mail.env   # works today (Gmail App Password)
#     cp mail/smtp2go.env.example mail.env   # once your SMTP2GO account is live
#     cp mail/none.env.example    mail.env   # or just don't create mail.env
# Then edit mail.env and `docker compose up -d`. See mail/README.md.

# ---- Cloudflare Tunnel ---------------------------------------------------------
# From: Cloudflare Zero Trust -> Networks -> Tunnels -> create tunnel.
# Add a public hostname on that tunnel:  auth.landeck.pro -> http://server:9000
CLOUDFLARED_TOKEN=
