# No email. Authentik runs normally; it just won't send password-reset or
# verification mail. For bootstrap this is the most secure option — no sending
# credential exists on the box at all.
#   * log in as akadmin with AUTHENTIK_BOOTSTRAP_PASSWORD
#   * create your own user in the admin UI and set its password directly
#   * invite others with copy-pasted links (Directory -> Invitations)
#
# All 8 keys are listed (empty) so switching away from / back to this preset is
# a complete replacement with nothing left behind.

AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=
AUTHENTIK_EMAIL__USE_SSL=
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=
