# SMTP2GO — use once the account exists and landeck.pro is a verified sender
# domain (add the SPF/DKIM records SMTP2GO gives you to Cloudflare DNS first).
#
# New domains: SMTP2GO makes you wait ~3 days after registration before you can
# create the account. Until then use mail/none.env.example or mail/resend.env.example.
#
# Host/port: mail.smtp2go.com on 2525 (also 8025 / 587 / 25). Create an SMTP
# user under Sending -> SMTP Users. That username/password is send-scoped and
# revocable on its own.

AUTHENTIK_EMAIL__HOST=mail.smtp2go.com
AUTHENTIK_EMAIL__PORT=2525
AUTHENTIK_EMAIL__USERNAME=          # SMTP2GO SMTP username
AUTHENTIK_EMAIL__PASSWORD=          # SMTP2GO SMTP password
AUTHENTIK_EMAIL__USE_TLS=true       # STARTTLS
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=no-reply@landeck.pro
