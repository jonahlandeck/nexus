# Gmail SMTP — works immediately, but the LEAST secure option here:
#   * the App Password is a bearer credential that can send mail as that whole
#     Google account and bypasses its 2FA
#   * it can't be scoped to "transactional send only"
#   * your address appears in every recipient's headers
#
# So: do NOT use your personal account. Make a dedicated Google account for this
# (e.g. landeck.mail@gmail.com), enable 2-Step Verification on it, and create an
# App Password there: https://myaccount.google.com/apppasswords
#
# Prefer mail/none.env.example (bootstrap) or mail/resend.env.example (works
# today, revocable send-only API key) unless you specifically want Gmail.
#
# Limits: ~500 recipients/day.  Gmail rewrites From: to the authenticated user.

AUTHENTIK_EMAIL__HOST=smtp.gmail.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=CHANGE-ME@gmail.com
AUTHENTIK_EMAIL__PASSWORD=          # 16-char App Password from the dedicated account
AUTHENTIK_EMAIL__USE_TLS=true       # STARTTLS on 587
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=CHANGE-ME@gmail.com
