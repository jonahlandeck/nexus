# Resend (https://resend.com) — SMTP, free tier, works today. Interim provider
# until the SMTP2GO account is available; then `./mail/use.sh smtp2go`.
#
# Why it's fine as an interim: the credential is a send-scoped API key, tied to
# no human login, revocable on its own in the dashboard.
#
# Setup:
#   1. Resend dashboard -> Domains -> Add Domain -> "landeck.pro" (or the
#      subdomain it suggests, e.g. send.landeck.pro).
#   2. It shows 3 DNS records (MX + SPF TXT + DKIM TXT). Add them in the
#      Cloudflare dashboard -> landeck.pro -> DNS -> Records. Back in Resend,
#      click Verify (usually a minute or two).
#   3. Set AUTHENTIK_EMAIL__FROM below to an address on the verified domain
#      (e.g. no-reply@landeck.pro, or no-reply@send.landeck.pro if you verified
#      the subdomain).
#   4. API Keys -> Create -> permission "Sending access". Paste the re_... value
#      into AUTHENTIK_EMAIL__PASSWORD below.
#
# Before the domain verifies you can only send FROM onboarding@resend.dev and
# only to your own signup address — enough for a quick test, not for invites.

AUTHENTIK_EMAIL__HOST=smtp.resend.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=resend
AUTHENTIK_EMAIL__PASSWORD=          # Resend API key, re_...
AUTHENTIK_EMAIL__USE_TLS=true       # STARTTLS on 587
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=no-reply@landeck.pro
